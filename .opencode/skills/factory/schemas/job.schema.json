{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactoryJob",
  "type": "object",
  "required": ["id", "source", "feature", "repo", "base_branch", "base_commit",
               "risk_tier", "branch", "worktree", "stage", "round",
               "retries_left", "reviews", "approval", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$" },
    "source": {
      "type": "object",
      "required": ["provider", "dedupe_key"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["manual", "linear", "github"] },
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "dedupe_key": { "type": "string" }
      }
    },
    "feature": { "type": "string", "minLength": 1 },
    "linear_id": { "type": ["string", "null"] },
    "repo": { "type": "string" },
    "base_branch": { "type": "string" },
    "base_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "depends_on": {
      "type": "array",
      "description": "Job ids this job builds on. Dispatch claims this job only once every id here has a merged pull request.",
      "items": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$" }
    },
    "risk_tier": { "enum": ["auto", "review", "approval"] },
    "branch": { "type": "string" },
    "worktree": { "type": "string" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "type": ["string", "null"] },
        "invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "agent", "session_id", "launched_at", "outcome"],
            "properties": {
              "stage": { "type": "string" },
              "agent": { "type": "string" },
              "session_id": { "type": "string", "minLength": 1 },
              "launched_at": { "type": "string", "format": "date-time" },
              "outcome": { "type": "string" }
            }
          }
        },
        "max_in_flight": { "type": "integer", "minimum": 0 }
      }
    },
    "stage": {
      "enum": ["intake", "needs_clarification", "planning",
               "awaiting_plan_approval", "building", "verifying", "repairing",
               "reviewing", "awaiting_human_review", "approved_to_merge",
               "handed_off", "merged", "queued", "blocked", "needs_human",
               "rejected", "cancelled"]
    },
    "round": { "type": "integer", "minimum": 0 },
    "spec_approved": { "type": "boolean" },
    "retries_left": { "type": "integer", "minimum": 0, "maximum": 2 },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["pending", "PASS", "CHANGES", "NOT_APPLICABLE"] },
        "security": { "enum": ["pending", "PASS", "CHANGES", "NOT_APPLICABLE"] },
        "scope": { "enum": ["pending", "PASS", "CHANGES", "NOT_APPLICABLE"] },
        "visual": { "enum": ["pending", "PASS", "CHANGES", "NOT_APPLICABLE"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "diff_ref"],
      "properties": {
        "approved": { "type": "boolean" },
        "diff_ref": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"], "format": "date-time" },
        "job": { "type": ["string", "null"] },
        "base_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
        "approver": { "type": ["string", "null"] }
      }
    },
    "full_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "command": { "type": ["string", "null"] },
        "exit_status": { "type": ["integer", "null"] },
        "result": { "enum": ["passed", "failed", "blocked", "not_run", "not_applicable"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "pushed"],
      "properties": {
        "branch": { "type": "string" },
        "ref": { "type": "string" },
        "pushed": { "type": "boolean" },
        "pr_url": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "cause": { "type": ["string", "null"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_paths", "pinned_at"],
      "properties": {
        "protected_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "The effective protected paths the job was claimed under, sorted."
        },
        "pinned_at": { "type": "string", "format": "date-time" }
      }
    },
    "retry_budget_reset_at": { "type": ["string", "null"], "format": "date-time" },
    "enqueued_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "blocked" } }, "required": ["stage"] },
      "then": {
        "required": ["cause"],
        "properties": { "cause": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "needs_human" } }, "required": ["stage"] },
      "then": {
        "required": ["cause"],
        "properties": { "cause": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
