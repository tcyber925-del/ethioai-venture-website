{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePackage",
  "type": "object",
  "required": ["job_id", "diff_ref", "checks"],
  "additionalProperties": false,
  "properties": {
    "job_id": { "type": "string" },
    "diff_ref": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["check", "category", "command", "cwd", "diff_ref",
                   "started_at", "ended_at", "result"],
      "additionalProperties": false,
      "properties": {
        "check": { "type": "string" },
        "category": { "enum": ["format", "lint", "types", "test", "build", "custom", "visual"] },
        "command": { "type": ["string", "null"] },
        "cwd": { "type": "string" },
        "diff_ref": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "exit_status": { "type": ["integer", "null"] },
        "output_ref": { "type": ["string", "null"] },
        "result": { "enum": ["passed", "failed", "blocked", "not_run", "not_applicable"] },
        "reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "enum": ["blocked", "not_run", "not_applicable"] } } },
          "then": { "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    }
  }
}
