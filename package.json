{
  "name": "ethioai-venture-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public website for EthioAI Venture — static-first Astro + TypeScript.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npx astro sync && npm run build && npm run check:dist"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
