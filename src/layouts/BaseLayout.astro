---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import { site } from "../config/site";

/**
 * Inter preload (ENG-102).
 *
 * DESIGN.md names Inter as the primary expression of the identity, but no
 * @font-face ever shipped it, so every visit rendered in the OS fallback face.
 * The fonts are self-hosted under /fonts — no external provider, no third-party
 * request; see src/styles/fonts.css for the subset and axis decisions.
 *
 * Preload the latin face only: it is the one every page needs, so preloading
 * it removes the request from the critical path. The latin-ext face is
 * deliberately NOT preloaded — no page uses a codepoint it covers, and a
 * speculative preload would spend bandwidth on a face the browser will never
 * select. `crossorigin` is required even though the font is same-origin: font
 * fetches are always made in CORS mode, so without it the preload is fetched
 * once and discarded, then fetched again for real.
 *
 * Kept in the frontmatter rather than as an HTML comment beside the tag: Astro
 * emits HTML comments to the browser, and a note this long would then be sent
 * on every single page load.
 *
 * There is now NO comment in the output at all, beside this note or the tag.
 * An earlier revision shipped a short pointer comment, and keeping its own byte
 * count true took three rounds of review: it said 243 B, became 317 B when the
 * text was reworded, and carried a stale "122-byte" claim in the same comment
 * that criticised shipping commentary to the browser. Restating a number is
 * what made it wrong; `rel="preload" as="font" crossorigin` needs no
 * explanation in the output anyway.
 */

interface Props {
  title: string;
  description?: string;
  /**
   * Emit `<meta name="robots" content="noindex">` — used by the 404 page,
   * which Cloudflare Pages serves for every unknown URL and which must not
   * enter the index (ENG-84).
   */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

/** Global metadata hook: page title composed with the approved site name. */
const documentTitle = title === site.name ? title : `${title} · ${site.name}`;

/**
 * Canonical path form (ENG-84). Astro reports route paths (`/about/`,
 * `/404`), never output file names; Cloudflare Pages' default
 * `auto-trailing-slash` HTML handling serves directory index files
 * (`about/index.html`) with a trailing slash and 307s the other form — so
 * directory routes canonicalize with the trailing slash (the form that
 * answers 200 without a redirect), root stays `/`.
 *
 * Pages flagged `noindex` (the 404 error page) emit neither `rel=canonical`
 * nor `og:url`: the flat error file has no self-referencing form that
 * answers 200, and a non-indexable page has no canonical to declare.
 * scripts/check-seo.mjs enforces both halves of this contract.
 */
const pathname = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(pathname, site.url).href;

/**
 * JSON-LD: the one schema type the shipped facts support (ENG-84 boundary).
 * `WebSite` describes this website itself — name, description and URL are
 * exactly the approved identity in src/config/site.ts, nothing invented.
 * No Organization/Person/Service/Product schema: those facts are not
 * represented in approved content.
 *
 * The `.replace(/</g, "\\u003c")` hardens the `set:html` injection below:
 * no `<` survives in the serialized text, so an identity value containing
 * `</script>` can never terminate the JSON block early.
 */
const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{documentTitle}</title>
    <!--
      Site icon. Declared explicitly because a browser with no icon link
      requests /favicon.ico on its own: that request 404'd on every page load
      (ENG-86 audit minor). The SVG monogram is primary for modern browsers;
      the .ico is the fallback for legacy agents, generated from the same
      geometry. check:dist validates both as internal references, so a missing
      file reds the build.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: var(--space-sm) var(--space-md);
        background: var(--color-surface);
        color: var(--color-primary);
        font-size: var(--text-body-sm-size);
      }

      .skip-link:focus {
        left: var(--space-md);
        top: var(--space-sm);
      }
    </style>
  </body>
</html>
