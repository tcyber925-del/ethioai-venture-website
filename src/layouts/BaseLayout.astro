---
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  description?: string;
  /**
   * Emit `<meta name="robots" content="noindex">` — used by the 404 page,
   * which Cloudflare Pages serves for every unknown URL and which must not
   * enter the index (ENG-84).
   */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

/** Global metadata hook: page title composed with the approved site name. */
const documentTitle = title === site.name ? title : `${title} · ${site.name}`;

/**
 * Canonical path form (ENG-84). Cloudflare Pages' default `auto-trailing-
 * slash` HTML handling serves directory index files (`about/index.html`)
 * with a trailing slash and flat `.html` files without one, redirecting the
 * other forms — so the canonical URL is the one form that answers 200
 * without a redirect. Root stays `/`.
 */
const pathname = Astro.url.pathname.endsWith(".html")
  ? Astro.url.pathname.replace(/\.html$/, "")
  : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(pathname, site.url).href;

/**
 * JSON-LD: the one schema type the shipped facts support (ENG-84 boundary).
 * `WebSite` describes this website itself — name, description and URL are
 * exactly the approved identity in src/config/site.ts, nothing invented.
 * No Organization/Person/Service/Product schema: those facts are not
 * represented in approved content.
 */
const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        padding: var(--space-sm) var(--space-md);
        background: var(--color-surface);
        color: var(--color-primary);
        font-size: var(--text-body-sm-size);
      }

      .skip-link:focus {
        left: var(--space-md);
        top: var(--space-sm);
      }
    </style>
  </body>
</html>
