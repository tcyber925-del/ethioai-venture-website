---
/**
 * Button — approved button variants per the visual design system.
 * Primary: tertiary background, surface text, md radius, 12px padding,
 * hover #0A4948. Secondary: surface background, primary text.
 * Renders an anchor when `href` is provided, a native button otherwise.
 * The primary CTA label/route per MIS: "Start a Project" -> /start-a-project.
 *
 * Dead-link guard (same rule as the shell nav, see config/routes.ts): when
 * `href` points at an internal route whose page module does not exist yet
 * (e.g. /start-a-project before ENG-83), the button renders as inert styled
 * text instead of a link, and becomes a real link automatically once the
 * route is added. External URLs and anchors are left untouched.
 */
import { routeExists } from "../config/routes";

interface Props {
  variant?: "primary" | "secondary";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  variant = "primary",
  href,
  type = "button",
  class: className = "",
} = Astro.props;

const isInternalRoute =
  href !== undefined && href.startsWith("/") && !href.startsWith("//");
const isLiveLink =
  href !== undefined && href !== "" && (!isInternalRoute || routeExists(href));
---

{href === undefined ? (
  <button type={type} class:list={["btn", `btn--${variant}`, className]}>
    <slot />
  </button>
) : isLiveLink ? (
  <a href={href} class:list={["btn", `btn--${variant}`, className]}>
    <slot />
  </a>
) : (
  <span
    class:list={["btn", `btn--${variant}`, className]}
    data-inert
    title="Page not yet available"
  >
    <slot />
  </span>
)}

<style>
  .btn {
    display: inline-block;
    padding: 12px; /* approved component spec: padding 12px */
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .btn--primary {
    background-color: var(--color-tertiary);
    color: var(--color-surface);
  }

  .btn--primary:hover {
    background-color: var(--color-tertiary-hover);
  }

  .btn--secondary {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-primary);
  }

  .btn--secondary:hover {
    border-color: var(--color-secondary);
  }

  /* Inert (route not built yet): no pointer, no hover feedback. */
  .btn[data-inert] {
    cursor: default;
  }

  .btn--primary[data-inert]:hover {
    background-color: var(--color-tertiary);
  }

  .btn--secondary[data-inert]:hover {
    border-color: var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
