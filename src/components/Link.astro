---
/**
 * Link — approved text link semantics.
 * Inline links keep the inherited text color with an underline for clarity;
 * hover/focus uses the tertiary accent (approved for "important links and
 * active states"). No target=_blank: links stay same-tab for predictability.
 */
import { GOATCOUNTER_SITE_ID } from "../config/analytics";

interface Props {
  href: string;
  class?: string;
  /** ENG-85 analytics event hook; omitted from output when absent. */
  "data-analytics-event"?: string;
}

const {
  href,
  class: className = "",
  "data-analytics-event": analyticsEvent,
} = Astro.props;

// While analytics is disabled (empty site ID) the hook is dropped from the
// markup: the listener never ships in that state, so the attribute would be
// inert bytes — and scripts/check-dist.mjs requires the disabled build to
// carry none. Once a site ID is configured the hook renders again.
// `.trim().length` rather than `=== ""`: the constant's literal type means a
// direct comparison is a type error once a real ID is configured.
const analyticsHook =
  GOATCOUNTER_SITE_ID.trim().length === 0 ? undefined : analyticsEvent;
---

<a
  href={href}
  class:list={["link", className]}
  data-analytics-event={analyticsHook}
>
  <slot />
</a>

<style>
  .link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .link:hover {
    color: var(--color-tertiary);
  }

  @media (prefers-reduced-motion: reduce) {
    .link {
      transition: none;
    }
  }
</style>
