---
import Container from "./Container.astro";
import Link from "./Link.astro";
import { site, primaryNav } from "../config/site";
import { routeExists } from "../config/routes";
import { isCurrentNavHref } from "../config/route-patterns";

/**
 * ENG-103 — the page being viewed, for `aria-current="page"`. Build-time and
 * static, so it costs nothing at runtime. Only a nav item whose target is the
 * current page (or a page beneath it) is marked; see isCurrentNavHref.
 */
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <Container>
    <div class="site-header__bar">
      <a class="wordmark" href="/">
        {site.name}
      </a>
      <nav aria-label="Primary" class="primary-nav">
        {/* role="list": Safari/VoiceOver drop list semantics when
            list-style:none removes the markers (ENG-103). */}
        <ul role="list">
          {primaryNav.map(({ label, href }) => (
            <li>
              {routeExists(href) ? (
                <Link
                  href={href}
                  aria-current={
                    isCurrentNavHref(href, currentPath) ? "page" : undefined
                  }
                >
                  {label}
                </Link>
              ) : (
                <span>{label}</span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  /*
   * ENG-106: the small-screen layout is composed deliberately, not left to
   * incidental `flex-wrap`. As one row at 320px the nav is a single flex item
   * beside the wordmark, so it is squeezed to whatever width is left over and
   * its labels then break mid-label inside that narrower list. Stacking the
   * wordmark and the nav onto their own rows gives the nav the full container
   * width, and the list's own wrap then breaks BETWEEN labels, never inside
   * one.
   *
   * Mobile-first: the base rule is the small screen, the existing 768px
   * breakpoint restores the two-up header. No new token, no new breakpoint, no
   * markup change, and no interaction (no hamburger, no disclosure, no JS) —
   * DESIGN.md authorises re-composition for small screens.
   */
  .site-header__bar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
  }

  .wordmark {
    color: var(--color-primary);
    font-size: var(--text-h3-size);
    font-weight: var(--text-h3-weight);
    line-height: var(--text-h3-leading);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wordmark:hover {
    color: var(--color-tertiary);
  }

  /*
   * Below 768px the five destinations need only the --space-sm gap: at 375px
   * they fit the container on ONE row, at 320px on two rows of whole labels.
   * From 768px the nav has the row to itself and regains --space-lg (the
   * ENG-103 rule, unchanged).
   */
  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  /*
   * ENG-103: nav links carry block padding so each target clears the 24x24 CSS
   * px minimum for pointer targets (WCAG 2.2 SC 2.5.8). The link text is
   * 14px/1.5 (21px); 4px block padding on each side gives 29px height, and the
   * horizontal gap already provides the separation. The anchors come from
   * Link.astro, so the rule is :global.
   *
   * ENG-106: `white-space: nowrap` keeps a destination from ever breaking
   * across lines mid-label; the list wraps BETWEEN whole labels instead. It
   * adds no width beyond the widest single label ("Start a Project"), which
   * fits the 320px content box on its own, so nothing can overflow.
   */
  .primary-nav :global(a) {
    display: inline-block;
    padding-block: var(--space-xs);
    white-space: nowrap;
  }

  /*
   * ENG-103: the current page's nav link is marked with the tertiary accent —
   * DESIGN.md reserves the accent for active states and important links — so
   * the state is conveyed by more than colour alone (weight too).
   */
  .primary-nav :global(a[aria-current="page"]) {
    color: var(--color-tertiary);
    font-weight: 600;
  }

  /* Route not yet implemented (G2/G3): plain text, no dead link. */
  .primary-nav span {
    color: var(--color-secondary);
    white-space: nowrap;
  }

  /*
   * From the existing 768px breakpoint the header is two-up again — the
   * approved desktop composition (ENG-103's, restored verbatim) — and the nav
   * regains the wider --space-lg gap. 1024px needs no rule: the flex row
   * already settles against the container's max-width.
   */
  @media (min-width: 768px) {
    .site-header__bar {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }

    .primary-nav ul {
      gap: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark {
      transition: none;
    }
  }
</style>
