---
import Container from "./Container.astro";
import Link from "./Link.astro";
import { site, primaryNav } from "../config/site";
import { routeExists } from "../config/routes";
import { isCurrentNavHref } from "../config/route-patterns";

const year = new Date().getFullYear();

/** ENG-103 — the page being viewed, for `aria-current="page"` on footer nav. */
const currentPath = Astro.url.pathname;
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__identity">
        <p class="footer-name">{site.name}</p>
        <p class="footer-tagline">{site.description}</p>
      </div>
      <nav aria-label="Footer" class="footer-nav">
        {/* role="list": restores list semantics where list-style:none strips
            the markers (ENG-103). */}
        <ul role="list">
          {primaryNav.map(({ label, href }) => (
            <li>
              {routeExists(href) ? (
                <Link
                  href={href}
                  aria-current={
                    isCurrentNavHref(href, currentPath) ? "page" : undefined
                  }
                >
                  {label}
                </Link>
              ) : (
                <span>{label}</span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="copyright">
      © {year} {site.name}
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-2xl);
    margin-top: auto;
  }

  .site-footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .footer-name {
    font-size: var(--text-h3-size);
    font-weight: var(--text-h3-weight);
    line-height: var(--text-h3-leading);
    color: var(--color-primary);
  }

  .footer-tagline {
    margin-top: var(--space-sm);
    color: var(--color-secondary);
  }

  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  /* ENG-103: block padding lifts each footer link to the 24x24 CSS px minimum
     target size (WCAG 2.2 SC 2.5.8); anchors come from Link.astro. */
  .footer-nav :global(a) {
    display: inline-block;
    padding-block: var(--space-xs);
  }

  /* ENG-103: current-page footer link uses the tertiary accent and a weight
     change — the same signal as the header, not colour alone. */
  .footer-nav :global(a[aria-current="page"]) {
    color: var(--color-tertiary);
    font-weight: 600;
  }

  .footer-nav span {
    color: var(--color-secondary);
  }

  .copyright {
    margin-top: var(--space-2xl);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .footer-nav ul {
      gap: var(--space-lg);
    }
  }
</style>
