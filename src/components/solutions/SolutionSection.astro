---
/**
 * SolutionSection — one step of the approved problem-first solution detail
 * sequence.
 *
 * Sources: spec 02 (IA/UX & Page Specification) and MIS v1.0 "Solutions":
 * Problem → What we build → Typical applications → How it works →
 * Capabilities → Related work → Engagement path → CTA.
 *
 * ENG-102 changed one thing here: a step with no approved content no longer
 * renders its heading. Previously each of the eight steps rendered a
 * full-size heading followed by "Content for this section is not yet
 * published.", so a solution detail page shipped 2,266px and 89 words with six
 * identical placeholders under 48px headings — indistinguishable from a broken
 * build. The approved structure stays visible: the caller lists pending step
 * titles in a single quiet PendingNote after the last real step.
 *
 * The evidence policy is untouched (MIS: leave a field empty or use truthful
 * status language — never fabricate). Only the presentation of absence changed.
 *
 * `hasContent` is explicit rather than inferred, so a step whose content
 * arrives through the slot (Related work) is not mistaken for an empty one. It
 * DEFAULTS TO FALSE on purpose: a caller that forgets the prop gets a dropped
 * section rather than a fabricated-looking placeholder. The cost of that
 * default is that a forgotten prop is silent — the call sites on
 * solutions/[slug].astro therefore all pass it explicitly, and
 * scripts/check-pending.mjs fails the build if a step ends up neither rendered
 * nor named pending.
 */
interface Props {
  /** Approved section heading (verbatim from the spec sequence). */
  heading: string;
  /** Whether the backing content field carries approved content. */
  hasContent?: boolean;
}

const { heading, hasContent = false } = Astro.props;
---

{hasContent && (
  <section class="solution-section">
    <h2>{heading}</h2>
    <div class="solution-section__body">
      <slot />
    </div>
  </section>
)}

<style>
  .solution-section {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .solution-section__body {
    margin-top: var(--space-lg);
  }
</style>
