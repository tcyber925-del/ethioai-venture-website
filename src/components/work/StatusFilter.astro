---
/**
 * StatusFilter — the "status taxonomy" step of the approved Work page
 * sequence (spec 02 / MIS: "Project index → status taxonomy → project detail").
 *
 * No approved status enum exists (see src/content.config.ts), so the chips are
 * derived at render time from the status strings actually present in the
 * projects collection and stay generic text chips — no invented status values,
 * colors or maturity semantics.
 *
 * Progressive enhancement: the block renders `hidden` and is revealed by the
 * script below, so a no-JS visitor sees the full, unfiltered list and no
 * inert controls.
 */
interface Props {
  statuses: string[];
}

const { statuses } = Astro.props;
---

{statuses.length > 0 && (
  <div class="filter" data-status-filter-root hidden>
    <p class="filter__label">Filter by status</p>
    <div
      class="filter__options"
      role="group"
      aria-label="Filter projects by status"
    >
      <button
        type="button"
        class="filter__chip"
        data-filter-status="*"
        aria-pressed="true"
      >
        All statuses
      </button>
      {statuses.map((status) => (
        <button
          type="button"
          class="filter__chip"
          data-filter-status={status}
          aria-pressed="false"
        >
          {status}
        </button>
      ))}
    </div>
    <p class="filter__count" role="status" data-filter-count />
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>("[data-status-filter-root]");

  if (root) {
    root.hidden = false;

    const chips = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-filter-status]"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-project-status]"),
    );
    const count = root.querySelector<HTMLElement>("[data-filter-count]");

    const apply = (value: string) => {
      let visible = 0;

      for (const card of cards) {
        const match = value === "*" || card.dataset.projectStatus === value;
        card.hidden = !match;
        if (match) visible += 1;
      }

      for (const chip of chips) {
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.filterStatus === value),
        );
      }

      if (count) {
        count.textContent = `Showing ${visible} of ${cards.length} ${
          cards.length === 1 ? "project" : "projects"
        }.`;
      }
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        apply(chip.dataset.filterStatus ?? "*");
      });
    }

    apply("*");
  }
</script>

<style>
  .filter[hidden] {
    display: none;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .filter__label {
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    line-height: var(--text-label-leading);
    letter-spacing: var(--text-label-tracking);
    color: var(--color-muted);
  }

  .filter__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .filter__chip {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-secondary);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .filter__chip:hover {
    border-color: var(--color-secondary);
    color: var(--color-primary);
  }

  .filter__chip[aria-pressed="true"] {
    border-color: var(--color-tertiary);
    color: var(--color-tertiary);
  }

  .filter__count {
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .filter__chip {
      transition: none;
    }
  }
</style>
