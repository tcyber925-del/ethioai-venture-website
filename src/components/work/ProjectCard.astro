---
/**
 * ProjectCard — approved "project card" primitive (spec 03 component list),
 * styled with the approved card spec from DESIGN.md (surface background,
 * lg radius, 24px padding, subtle border, low elevation).
 *
 * Only fields with approved source data render; empty fields stay empty
 * (MIS evidence policy). The root element carries `data-project-status` so
 * the Work index can filter cards client-side over the status strings
 * actually present in seed data (no approved status enum exists yet).
 *
 * ENG-106: the card is activatable across its whole surface through its single
 * existing title link (a stretched ::after overlay over a positioned card root)
 * — the card ships exactly one interactive element and one tab stop.
 */
import Link from "../Link.astro";
import MetadataLabel from "../MetadataLabel.astro";
import StatusBadge from "./StatusBadge.astro";
import { hasContent as carries } from "../../lib/content";

interface Props {
  title: string;
  slug: string;
  status?: string;
  category?: string;
  summary?: string;
}

const { title, slug, status, category, summary } = Astro.props;
---

<li class="project-card" data-project-status={status ?? ""}>
  <div class="project-card__meta">
    {carries(category) && <MetadataLabel>{category}</MetadataLabel>}
    {carries(status) && <StatusBadge status={status} />}
  </div>
  <h3 class="project-card__title">
    <Link href={`/work/${slug}`}>{title}</Link>
  </h3>
  {carries(summary) && <p class="project-card__summary">{summary}</p>}
</li>

<style>
  /*
   * ENG-106: the whole card is the hit target, not just the title text. The
   * card root is the positioning context for the title link's ::after overlay
   * (below), so the entire surface activates the ONE link that already exists —
   * no second anchor, no wrapper element, no click handler, and therefore still
   * exactly one tab stop per card.
   *
   * transition + :hover/:focus-within is ResearchCard's established card-state
   * treatment, reused verbatim; the default boundary stays --color-border.
   */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition: border-color 0.15s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-secondary);
  }

  /*
   * Author display rules beat the UA [hidden] rule, so filtering must
   * re-assert `display: none` or hidden cards stay on screen.
   */
  .project-card[hidden] {
    display: none;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .project-card__title {
    font-size: var(--text-h3-size);
    font-weight: var(--text-h3-weight);
    line-height: var(--text-h3-leading);
  }

  .project-card__summary {
    color: var(--color-secondary);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  /*
   * The overlay that stretches the existing title link across the card.
   * `inset: 0` resolves against .project-card (position: relative above). The
   * anchor is rendered by Link.astro and so carries Link's own scoping
   * attribute, not this component's — the rule must be written through
   * :global() or it compiles to a selector matching nothing (same trap as
   * Header.astro's `.primary-nav :global(a)`).
   */
  .project-card__title :global(a::after) {
    content: "";
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
