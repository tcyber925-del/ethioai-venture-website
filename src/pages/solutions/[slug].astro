---
/**
 * /solutions/[slug] — solution detail.
 *
 * Approved problem-first structure (spec 02 / MIS v1.0 "Solutions"):
 * Problem → What we build → Typical applications → How it works →
 * Capabilities → Related work → Engagement path → CTA.
 *
 * Every step renders its approved heading when it carries approved content;
 * steps whose content field is empty render no heading and are named once in a
 * quiet PendingNote after the last real step (ENG-102). Routes are generated
 * from the solutions collection so page URLs stay equal to the approved V1
 * routes.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Link from "../../components/Link.astro";
import MetadataLabel from "../../components/MetadataLabel.astro";
import SolutionSection from "../../components/solutions/SolutionSection.astro";
import PendingNote from "../../components/PendingNote.astro";
import RelatedWork from "../../components/solutions/RelatedWork.astro";
import StartProjectCta from "../../components/solutions/StartProjectCta.astro";
import { site } from "../../config/site";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");
  return solutions.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"solutions">;
}

const { entry } = Astro.props;
const { data } = entry;

const [projects, research] = await Promise.all([
  getCollection("projects"),
  getCollection("research"),
]);

/** Whether an optional content field carries approved content. */
const hasText = (value: string | undefined): boolean =>
  typeof value === "string" && value.trim().length > 0;

const hasList = (value: string[] | undefined): boolean =>
  Array.isArray(value) && value.length > 0;

/**
 * ENG-102 — the approved problem-first sequence, in order, with the honest
 * "does this step carry approved content" test for each.
 *
 * This list drives what the PendingNote names as pending. It is NOT the single
 * source of truth for rendering: the `<SolutionSection>` call sites below carry
 * their own `hasContent={...}` test for the same field, so the two are parallel
 * and COULD drift — nothing compares them directly.
 *
 * What does hold them together is scripts/check-pending.mjs, which reads the
 * approved sequence from this page's own rendered output and asserts that every
 * approved step appears exactly once across the rendered headings and the
 * pending note. That catches drift in the direction that matters (a step
 * rendered twice, named twice, or neither), though not a pending entry that
 * matches a step the call sites have forgotten entirely.
 *
 * `Related work` is always considered present — RelatedWork renders its own
 * honest state (declared relations, or that none are declared yet) rather than
 * a placeholder, so suppressing its heading would hide that.
 */
const sequence = [
  { heading: "Problem", present: hasText(data.problem) },
  { heading: "What we build", present: hasText(data.what_we_build) },
  { heading: "Typical applications", present: hasList(data.applications) },
  { heading: "How it works", present: hasText(data.how_it_works) },
  { heading: "Capabilities", present: hasList(data.capabilities) },
  { heading: "Related work", present: true },
  { heading: "Engagement path", present: hasText(data.engagement_path) },
];

const pendingSteps = sequence.filter((step) => !step.present);

/**
 * Unique meta description (ENG-84): the approved summary when the entry
 * carries one; otherwise a mechanical composition of the approved title
 * with the approved site identity — "solution area" is the approved term
 * (about page), never fabricated page copy.
 */
const description = hasText(data.summary)
  ? data.summary
  : `${data.title} — a solution area from EthioAI Venture. ${site.description}.`;
---

<BaseLayout title={data.title} description={description}>
  <Container>
    <header class="hero">
      <MetadataLabel>
        <Link href="/solutions">Solutions</Link>
      </MetadataLabel>
      <h1>{data.title}</h1>
      {hasText(data.summary) && <p class="lead">{data.summary}</p>}
      {hasText(data.status) && (
        <p class="hero__status">
          <MetadataLabel>{data.status}</MetadataLabel>
        </p>
      )}
    </header>

    <SolutionSection heading="Problem" hasContent={hasText(data.problem)}>
      {hasText(data.problem) && <p>{data.problem}</p>}
    </SolutionSection>

    <SolutionSection
      heading="What we build"
      hasContent={hasText(data.what_we_build)}
    >
      {hasText(data.what_we_build) && <p>{data.what_we_build}</p>}
    </SolutionSection>

    <SolutionSection
      heading="Typical applications"
      hasContent={hasList(data.applications)}
    >
      {hasList(data.applications) && (
        <ul class="section-list">
          {data.applications?.map((application) => (
            <li>{application}</li>
          ))}
        </ul>
      )}
    </SolutionSection>

    <SolutionSection
      heading="How it works"
      hasContent={hasText(data.how_it_works)}
    >
      {hasText(data.how_it_works) && <p>{data.how_it_works}</p>}
    </SolutionSection>

    <SolutionSection
      heading="Capabilities"
      hasContent={hasList(data.capabilities)}
    >
      {hasList(data.capabilities) && (
        <ul class="section-list">
          {data.capabilities?.map((capability) => (
            <li>{capability}</li>
          ))}
        </ul>
      )}
    </SolutionSection>

    {/*
      ENG-102 — one quiet statement of which approved steps have no content
      yet, instead of a full-size heading and a repeated placeholder per step.
      The step names and order are the approved ones; nothing is fabricated and
      no step is silently dropped.

      Placed BEFORE Related work deliberately. Related work is the one step that
      always renders (it reports its own honest state), so putting the note last
      left the page reading: step 6 → then a list of steps 1–5 and 7. Here the
      pending steps appear in approved order first, and Related work follows in
      its sequence position.
    */}
    <PendingNote sections={pendingSteps.map((step) => step.heading)} />

    <SolutionSection heading="Related work" hasContent={true}>
      <RelatedWork
        related={data.related_work ?? []}
        projects={projects}
        researchCount={research.length}
      />
    </SolutionSection>

    <SolutionSection
      heading="Engagement path"
      hasContent={hasText(data.engagement_path)}
    >
      {hasText(data.engagement_path) && <p>{data.engagement_path}</p>}
    </SolutionSection>

    <StartProjectCta />
  </Container>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .hero h1 {
    margin-top: var(--space-md);
  }

  .lead {
    margin-top: var(--space-lg);
    max-width: 60ch;
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--color-secondary);
  }

  .hero__status {
    margin-top: var(--space-md);
  }

  .section-list {
    padding-inline-start: var(--space-xl);
  }

  .section-list li + li {
    margin-top: var(--space-sm);
  }
</style>
