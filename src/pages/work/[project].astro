---
/**
 * /work/[project] — project detail (spec 02 / MIS approved sequence:
 * Problem → What We Built → Architecture → Technical Implementation →
 * Evidence → Limitations → What We Learned → Next → Related Work → CTA).
 *
 * Built from the `projects` collection glob, so any future entry routes
 * automatically. Fields without approved source content never render a
 * heading or a body: they are named once, quietly, in a single PendingNote
 * (ENG-102). The note sits after the last content step, and before the Related
 * Work section when that section has real links to show — Related Work is the
 * one step rendered from a separate branch rather than from `sequence`, so it
 * can be either a rendered section or a pending entry. Related Work resolves
 * only from solution entries whose `related_work` names this project, and no
 * relation is invented for it. The evidence policy is unchanged — a step is
 * either real approved content or an honest statement that it is not published
 * yet, never fabricated copy (MIS evidence policy).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Link from "../../components/Link.astro";
import Button from "../../components/Button.astro";
import MetadataLabel from "../../components/MetadataLabel.astro";
import StatusBadge from "../../components/work/StatusBadge.astro";
import ProjectSection from "../../components/work/ProjectSection.astro";
import PendingNote from "../../components/PendingNote.astro";
import { routeExists } from "../../config/routes";
import { hasContent } from "../../lib/content";
import { site } from "../../config/site";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { project: project.data.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;

// ENG-102 — `hasContent` is the shared predicate from src/lib/content.ts, so a
// field that is an empty or whitespace-only string counts as absence here exactly
// as it does on the homepage and on /solutions. Without the shared rule, the same
// field could render a section on one page and be reported pending on another.
const carries = hasContent;

const technologies = data.technologies ?? [];
const images = data.images ?? [];

/**
 * ENG-102 — the approved project-detail sequence, in order, each step with the
 * honest "does this carry approved content" test. ONE list drives both what
 * renders as a section and what the single PendingNote names as pending, so the
 * two cannot drift: adding a step here puts it in both places automatically.
 * (An earlier pass kept `sections` and `pendingTitles` as two parallel arrays,
 * where adding a ninth step would silently omit it from the note.)
 *
 * Step bodies carry only approved content, never a placeholder string. A step
 * with no approved body renders no heading at all. The evidence policy is
 * unchanged (MIS: state absence honestly, never fabricate) — only the rendering
 * is: previously every step rendered a full-size heading plus an identical
 * one-line placeholder, so /work/ethiobio shipped ten headings above the same
 * eight-word sentence nine times, over 2,110px, and "no evidence yet" looked
 * typographically identical to "evidence".
 *
 * Evidence is the one step with two content shapes: evidence text, or evidence
 * images when the text is absent. An entry carrying images therefore has a real
 * Evidence section (the images slot renders instead of a body paragraph), so
 * `hasImages` participates in the presence test below.
 *
 * Every entry carries `hasImages` explicitly rather than only the evidence
 * step. Omitting it on the others makes the array a union whose members do not
 * all have the property, so reading `step.hasImages` is a type error waiting to
 * happen and a uniform shape keeps both the filter and the render honest.
 */
const sequence = [
  {
    id: "problem",
    title: "Problem",
    body: data.problem,
    hasImages: false,
  },
  {
    id: "built",
    title: "What We Built",
    body: data.built,
    hasImages: false,
  },
  {
    id: "architecture",
    title: "Architecture",
    body: data.architecture,
    hasImages: false,
  },
  {
    id: "implementation",
    title: "Technical Implementation",
    body: data.implementation,
    hasImages: false,
  },
  {
    id: "evidence",
    title: "Evidence",
    body: data.evidence,
    // An entry whose only evidence is images still has a real Evidence
    // section: the images are the evidence.
    hasImages: images.length > 0,
  },
  {
    id: "limitations",
    title: "Limitations",
    body: data.limitations,
    hasImages: false,
  },
  {
    id: "learnings",
    title: "What We Learned",
    body: data.learnings,
    hasImages: false,
  },
  { id: "next", title: "Next", body: data.next, hasImages: false },
];

/** Steps with approved content, in approved order. */
const sections = sequence.filter(
  (step) => carries(step.body) || step.hasImages,
);

/** Steps without it — named once, quietly, by PendingNote. */
const pendingSteps = sequence
  .filter((step) => !carries(step.body) && !step.hasImages)
  .map((step) => step.title);

const solutions = await getCollection("solutions");
const relatedSolutions = solutions.filter((solution) =>
  (solution.data.related_work ?? []).includes(data.slug),
);

/**
 * Unique meta description (ENG-84): the approved summary when the entry
 * carries one; otherwise a mechanical composition of approved fields only
 * — title always, status when the entry has one (MIS: EthioBio must show
 * In Development). No fabricated copy.
 *
 * `carries` rather than a local typeof/trim test — this was the fourth copy of
 * that rule in this file's neighbourhood, and a description must agree with
 * whether the page itself treats the summary as content.
 */
const description = carries(data.summary)
  ? data.summary
  : `${data.title} — selected work from EthioAI Venture.` +
    (carries(data.status) ? ` Status: ${data.status}.` : "");
---

<BaseLayout title={data.title} description={description}>
  <Container>
    <p class="project-back">
      <Link href="/work">All work</Link>
    </p>

    <header class="project-header">
      <MetadataLabel>Project</MetadataLabel>
      <h1>{data.title}</h1>
      <div class="project-header__meta">
        {data.status && <StatusBadge status={data.status} />}
        {data.category && <MetadataLabel>{data.category}</MetadataLabel>}
      </div>
      {data.summary && <p class="project-header__summary">{data.summary}</p>}
      {technologies.length > 0 && (
        <div class="project-header__tech">
          <MetadataLabel>Technologies</MetadataLabel>
          <ul class="tech-list">
            {technologies.map((technology) => (
              <li class="tech-list__item">{technology}</li>
            ))}
          </ul>
        </div>
      )}
      {(data.github || data.demo) && (
        <p class="project-header__links">
          {data.github && (
            <Link href={data.github} data-analytics-event="github-click">
              GitHub
            </Link>
          )}
          {data.demo && (
            <Link href={data.demo} data-analytics-event="demo-click">
              Demo
            </Link>
          )}
        </p>
      )}
    </header>

    {sections.map((section) => (
      // hasContent is passed EXPLICITLY. ProjectSection defaults it to
      // `body !== undefined`, which silently drops an Evidence step whose
      // content is images rather than text — the images slot renders inside
      // the section, so without this the step would render nothing at all
      // while also being excluded from pendingSteps. The field is in the schema
      // (content.config.ts), so that case is reachable.
      <ProjectSection
        id={section.id}
        title={section.title}
        body={section.body}
        hasContent={carries(section.body) || section.hasImages}
      >
        {section.id === "evidence" && images.length > 0 && (
          <ul class="evidence-images">
            {images.map((image) => (
              <li>
                <img
                  src={image}
                  alt={`${data.title} project image`}
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        )}
      </ProjectSection>
    ))}

    <PendingNote
      sections={[
        ...pendingSteps.map((title) => ({ title })),
        // ENG-102: state the actual reason for Related Work. Projects exist —
        // no solution entry declares a relation to this one yet, which is a
        // different fact from "no approved content published for this section".
        ...(relatedSolutions.length === 0
          ? [
              {
                title: "Related Work",
                detail:
                  "no approved related-work relationship is declared for this project yet",
              },
            ]
          : []),
      ]}
    />

    {relatedSolutions.length > 0 && (
      <ProjectSection id="related-work" title="Related Work" hasContent={true}>
        <ul class="related-list">
          {relatedSolutions.map((solution) => (
            <li>
              {routeExists(`/solutions/${solution.data.slug}`) ? (
                <Link href={`/solutions/${solution.data.slug}`}>
                  {solution.data.title}
                </Link>
              ) : (
                <span>{solution.data.title}</span>
              )}
            </li>
          ))}
        </ul>
      </ProjectSection>
    )}

    <section class="cta" aria-labelledby="cta-heading">
      <h2 id="cta-heading">Start a Project</h2>
      <p class="cta__text">{site.description}</p>
      {routeExists("/start-a-project") && (
        <Button href="/start-a-project">Start a Project</Button>
      )}
    </section>
  </Container>
</BaseLayout>

<style>
  .project-back {
    padding-top: var(--space-2xl);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .project-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .project-header__summary {
    max-width: 72ch;
    color: var(--color-secondary);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
  }

  .project-header__tech {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-list__item {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-mono-size);
    line-height: var(--text-mono-leading);
  }

  .project-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  .evidence-images {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .evidence-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .evidence-images img {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    margin-block: var(--space-xl) var(--space-3xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .cta h2 {
    font-size: var(--text-h3-size);
    font-weight: var(--text-h3-weight);
    line-height: var(--text-h3-leading);
    letter-spacing: var(--text-h3-tracking);
  }

  .cta__text {
    color: var(--color-secondary);
  }
</style>
