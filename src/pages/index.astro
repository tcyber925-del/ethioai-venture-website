---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import MetadataLabel from "../components/MetadataLabel.astro";
import Button from "../components/Button.astro";
import Link from "../components/Link.astro";
import Section from "../components/home/Section.astro";
import StatusBadge from "../components/home/StatusBadge.astro";
import { getCollection } from "astro:content";
import { routeExists } from "../config/routes";

/*
 * Homepage — ENG-78.
 *
 * Required sequence (MIS v1.0 "Page contracts / Homepage" + spec 02):
 *   Hero → Problem/Value → What We Build → Selected Work → How We Approach
 *   Projects → Research & Products → Engineering Depth → Ethiopia/Africa/
 *   Global → Founder → CTA
 *
 * MIS requirements: one clear H1 (hero); primary CTA to /start-a-project;
 * secondary navigation to proof surfaces; consume reusable content instead
 * of duplicating project/solution data; no unsupported metrics or social
 * proof (MIS "Evidence and content policy" — copy below only restates
 * approved positioning and verifiable repository facts).
 *
 * Internal links follow the shell's dead-link rule (ENG-77 routes.ts):
 * rendered inert until the target page module exists, auto-linked after.
 *
 * Claim sources, quoted in-repo so they are verifiable here (PR #7 carries
 * the Notion permalinks):
 * - "founder-led" + Ethiopia → Africa → global direction: Linear ENG-82 —
 *   "Build the founder-led company story, Ethiopia → Africa → Global
 *   positioning, current focus and long-term venture-studio direction
 *   without unsupported claims."
 * - Audience framing: MIS v1.0 Product contract — "Primary audience:
 *   Organizations with concrete AI, workflow, knowledge or document
 *   problems." / "Core proposition: Practical AI systems for real-world
 *   organizations."
 * - Section sequence: spec 02 — "Hero → Problem/Value → What We Build →
 *   Selected Work → How We Approach Projects → Research & Products →
 *   Engineering Depth → Ethiopia/Africa/Global → Founder → CTA."
 */
const solutions = (await getCollection("solutions")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const research = (await getCollection("research")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

/*
 * ENG-102 — Engineering depth renders real work evidence, so it reads from the
 * same collection entries: only a project that actually carries approved
 * evidence (`evidence` text and/or a declared technology stack) can appear.
 * Deriving the list means the section cannot claim depth no entry supports, and
 * it stays correct as entries are added — no homepage copy to drift.
 */
const evidencedProjects = projects.filter(
  (project) =>
    typeof project.data.evidence === "string" ||
    (project.data.technologies?.length ?? 0) > 0,
);

/* Built in frontmatter: Astro trims whitespace between text and an inline
 * expression, which rendered "across5 focused areas" (review finding). */
let solutionsIntro = "We build practical AI systems:";
if (solutions.length === 1) {
  solutionsIntro = "We build practical AI systems across 1 focused area:";
} else if (solutions.length > 1) {
  solutionsIntro = `We build practical AI systems across ${solutions.length} focused areas:`;
}
---

<BaseLayout title="EthioAI Venture">
  <!-- 1. Hero — one clear H1 (MIS) -->
  <section class="hero" id="hero">
    <Container>
      <MetadataLabel>AI engineering studio</MetadataLabel>
      <h1>EthioAI Venture</h1>
      <p class="hero__lede">
        Practical AI systems for real-world organizations.
      </p>
      <div class="hero__actions">
        <Button variant="primary" href="/start-a-project">
          Start a Project
        </Button>
        <Button variant="secondary" href="/work">
          View work
        </Button>
      </div>
    </Container>
  </section>

  <!-- 2. Problem/Value -->
  <Section
    id="problem-value"
    eyebrow="Problem and value"
    title="Customer problems before technology"
  >
    <p>
      EthioAI Venture is built for organizations with concrete AI, workflow,
      knowledge or document problems. The goal is not AI for its own sake — it
      is a working system that solves the problem and holds up in real use.
    </p>
  </Section>

  <!-- 3. What We Build — consumes the solutions collection -->
  <Section id="what-we-build" eyebrow="Solutions" title="What we build">
    <p>{solutionsIntro}</p>
    <ul class="card-grid" role="list">
      {solutions.map(({ data }) => (
        <li class="card">
          {routeExists(`/solutions/${data.slug}`) ? (
            <Link href={`/solutions/${data.slug}`}>{data.title}</Link>
          ) : (
            <span class="card__text">{data.title}</span>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- 4. Selected Work — consumes the projects collection -->
  <Section id="selected-work" eyebrow="Evidence" title="Selected work">
    <ul class="card-grid" role="list">
      {projects.map(({ data }) => (
        <li class="card">
          {routeExists(`/work/${data.slug}`) ? (
            <Link href={`/work/${data.slug}`}>{data.title}</Link>
          ) : (
            <span class="card__text">{data.title}</span>
          )}
          {/*
            ENG-102: render the entry's own approved summary where the data
            already carries one — the same field /work already passes
            (work/index.astro), so the homepage states each project's actual
            subject instead of a bare title and a status badge. EthioBio has no
            approved summary and the absence stays silent rather than becoming
            a placeholder.
          */}
          {data.summary && <p class="card__summary">{data.summary}</p>}
          {data.status && (
            <p class="card__status">
              <StatusBadge status={data.status} />
            </p>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- 5. How We Approach Projects -->
  <Section id="approach" eyebrow="Approach" title="How we approach projects">
    <ul class="approach-list" role="list">
      <li>
        <h3>Start from the problem</h3>
        <p>
          We begin with the concrete workflow, knowledge or document problem —
          not with technology for its own sake.
        </p>
      </li>
      <li>
        <h3>Build working systems</h3>
        <p>
          We implement practical AI systems: working software first, described
          honestly.
        </p>
      </li>
      <li>
        <h3>Show the evidence</h3>
        <p>
          Proof before marketing: we state what exists, what it does and where
          its limits are — including when something is still in development.
        </p>
      </li>
    </ul>
  </Section>

  <!-- 6. Research & Products — consumes the research collection (empty today) -->
  <Section
    id="research-products"
    eyebrow="Research"
    title="Research and products"
  >
    {research.length > 0 ? (
      <ul class="card-grid" role="list">
        {research.map(({ data }) => (
          <li class="card">
            {routeExists(`/research/${data.slug}`) ? (
              <Link href={`/research/${data.slug}`}>{data.title}</Link>
            ) : (
              <span class="card__text">{data.title}</span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p>
        Research and product notes are being prepared and will be published here
        as they are ready.
      </p>
    )}
  </Section>

  <!-- 7. Engineering Depth — verifiable repository facts only -->
  <Section
    id="engineering-depth"
    eyebrow="How it is built"
    title="Engineering depth"
  >
    {/*
      ENG-102: this step used to describe the website's own build (Astro,
      typed collections, CI, Notion) — verifiable, but self-referential, and it
      occupied the homepage's most confident position while proving nothing about
      the studio's AI engineering. It now renders the same approved evidence the
      project entries already carry, read from the collection rather than
      restated here, so the homepage cannot drift from /work.

      No lead paragraph: every word in this section comes from a project entry,
      because the approved evidence policy puts invented copy on this site out
      of bounds. The eyebrow and heading above are the approved section
      identity (frozen by spec 02); the evidence below is approved content.
    */}
    <ul class="evidence-list" role="list">
      {evidencedProjects.map(({ data }) => (
        <li class="evidence">
          <p class="evidence__title">
            <Link href={`/work/${data.slug}`}>{data.title}</Link>
          </p>
          {/* The entry's own approved `technologies` values (LangGraph,
              pgvector, BM25, …) — the approved list, not a homepage rewrite
              of it. */}
          {data.technologies && data.technologies.length > 0 && (
            <ul class="evidence__stack" role="list">
              {data.technologies.map((technology) => (
                <li class="evidence__tech">{technology}</li>
              ))}
            </ul>
          )}
          {/* The entry's own approved `evidence` prose, reused verbatim —
              it is what states the tagged release and the deployed dashboard.

              Both approved links must render here, not one: that sentence ends
              "See the links on this page for both." Reusing it verbatim while
              showing only the repository made the homepage state something
              false — the exact failure the evidence policy exists to prevent.
              ENG-102 lists the live demo as approved evidence to communicate,
              so both are rendered and the sentence is true here as it is on
              /work/ethiosci. */}
          {data.evidence && <p class="evidence__text">{data.evidence}</p>}
          {(data.github || data.demo) && (
            <p class="evidence__links">
              {data.github && (
                <Link href={data.github} data-analytics-event="github-click">
                  Repository
                </Link>
              )}
              {data.demo && (
                <Link href={data.demo} data-analytics-event="demo-click">
                  Live demo
                </Link>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- 8. Ethiopia/Africa/Global -->
  <Section
    id="geography"
    eyebrow="Geography"
    title="Ethiopia → Africa → global"
  >
    <p>
      EthioAI Venture's direction is Ethiopia → Africa → global: build for
      organizations in Ethiopia first, grow across Africa, and compete on the
      global stage.
    </p>
  </Section>

  <!-- 9. Founder -->
  <Section id="founder" eyebrow="Leadership" title="Founder-led">
    <p>
      EthioAI Venture is founder-led, with a long-term direction as a venture
      studio focused on building practical AI systems. The full company story,
      current focus and long-term direction will live on the About page.
    </p>
  </Section>

  <!-- 10. CTA -->
  <Section
    id="cta"
    eyebrow="Next step"
    title="Start a project"
    variant="surface"
  >
    <p>
      Tell us about the problem you are trying to solve. We will start there.
    </p>
    <p class="cta__actions">
      <Button variant="primary" href="/start-a-project">
        Start a Project
      </Button>
    </p>
  </Section>
</BaseLayout>

<style>
  /* Hero — generous whitespace, quiet technical confidence */
  .hero {
    padding-block: var(--space-3xl);
  }

  .hero h1 {
    margin-top: var(--space-sm);
  }

  .hero__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    max-width: 36rem;
  }

  .hero__actions {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-5xl);
    }
  }

  /* Card grid — used sparingly (solutions, selected work, research) */
  .card-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    /* auto-fill (not auto-fit): a lone card keeps its track width instead
       of stretching across the whole row. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .card :global(a),
  .card__text {
    font-size: var(--text-body-lg-size);
    font-weight: 600;
  }

  /*
   * ENG-102: the summary uses the same treatment as /work's ProjectCard
   * summary — `--text-body-sm-size` in --color-secondary — so a project's
   * description reads identically on the homepage and on /work, and the title
   * stays the dominant element in the card.
   */
  .card__summary {
    margin-top: var(--space-md);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    color: var(--color-secondary);
  }

  .card__status {
    margin-top: var(--space-md);
  }

  /* Approach — editorial three-column list, stacks on mobile */
  .approach-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .approach-list p {
    margin-top: var(--space-sm);
    color: var(--color-secondary);
  }

  @media (min-width: 1024px) {
    .approach-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Engineering depth — definition list; mono reserved for technical ids */
  /*
   * Engineering depth (ENG-102) — the approved project's own stack and
   * evidence. Cards reuse the surface/border/radius card treatment so the
   * section reads as the same evidence family as Selected work above it, not as
   * a new visual voice.
   */
  .evidence-list {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-lg);
    /* The evidence list is a layout container, not prose — reset the UA list
       styling so no marker or indent offsets the cards from the section's
       left edge. role="list" keeps list semantics for VoiceOver, which
       list-style:none otherwise strips. */
    list-style: none;
    padding: 0;
  }

  .evidence {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .evidence__title {
    font-size: var(--text-body-lg-size);
    font-weight: 600;
  }

  /* Mono is approved for technical identifiers; a named stack is that. */
  .evidence__stack {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .evidence__tech {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-mono-size);
    line-height: var(--text-mono-leading);
    color: var(--color-secondary);
  }

  /* 60ch, matching home/Section.astro's editorial measure for prose inside a
     Section — 72ch measured 91 characters per line inside a section whose own
     paragraph was capped at 56. */
  .evidence__text {
    margin-top: var(--space-md);
    max-width: 60ch;
    color: var(--color-secondary);
  }

  .evidence__links {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  .cta__actions {
    margin-top: var(--space-xl);
  }
</style>
