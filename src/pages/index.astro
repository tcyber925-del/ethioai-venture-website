---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import MetadataLabel from "../components/MetadataLabel.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="EthioAI Venture">
  <Container>
    <main>
      <MetadataLabel>AI engineering studio</MetadataLabel>
      <h1>EthioAI Venture</h1>
      <p>Practical AI systems for real-world organizations.</p>
      <Button href="/start-a-project">Start a Project</Button>
    </main>
  </Container>
</BaseLayout>
